{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "wings-capability",
  "description": "Capability for wings detached into their own windows. Each runs the same frontend as the widget, on the same origin (WebviewUrl::App, never External), and drives the same shared WS client \u2014 so it needs the widget's permissions and no `remote` block.",
  "windows": [
    "wing-chat",
    "wing-dashboard"
  ],
  "permissions": [
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-set-size",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-scale-factor",
    "core:window:allow-inner-size",
    "core:event:default"
  ]
}
