# Benchmark API Provider Configuration
# Copy this file to .env.benchmark and fill in your API key.
# NEVER commit .env.benchmark to git.

# --- Chutes AI (OpenAI-compatible) ---
# Get your key at: https://chutes.ai/
IRIS_BENCHMARK_API_KEY=your_chutes_api_key_here
IRIS_BENCHMARK_API_URL=https://api.chutes.ai/v1
IRIS_BENCHMARK_MODEL=chutes-ai/llama-3.3-70b

# --- Alternative providers (uncomment one) ---
# # Cohere
# IRIS_BENCHMARK_API_KEY=your_cohere_key_here
# IRIS_BENCHMARK_API_URL=https://api.cohere.com/compatibility/v1
# IRIS_BENCHMARK_MODEL=command-a-03-2025
#
# # OpenAI
# IRIS_BENCHMARK_API_KEY=sk-your-openai-key-here
# IRIS_BENCHMARK_API_URL=https://api.openai.com/v1
# IRIS_BENCHMARK_MODEL=gpt-4o-mini
#
# # Local / LM Studio
# IRIS_BENCHMARK_API_KEY=not-needed-for-local
# IRIS_BENCHMARK_API_URL=http://localhost:1234/v1
# IRIS_BENCHMARK_MODEL=local-model
