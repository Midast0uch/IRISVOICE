# IRIS Backend Configuration
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local (NOT .env — that file is gitignored)
# to override the defaults below.  Real API keys go in .env.local.
# The backend reads .env.local first, then falls back to .env.example.
#
# Example:  cp .env.example .env.local   # then edit .env.local
# ──────────────────────────────────────────────────────────────────────────

# Backend server
BACKEND_HOST=localhost
BACKEND_PORT=8090

# Logging
LOG_LEVEL=INFO
LOG_DIR=backend/logs

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Picovoice (Porcupine wake word detection)
# Get a free key at: https://console.picovoice.ai/
# (AccessKey is free for development — unlimited wake words, no credit card)
PICOVOICE_ACCESS_KEY=
# Sign up at https://exa.ai to get a free API key (20k requests/month)
# EXA_API_KEY=your-key-hereyour_picovoice_access_key_here

# Hugging Face (model downloads / embeddings)
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Wake word model
WAKE_WORD_MODEL=Hey Iris
WAKE_WORD_PPN=backend/models/wake_words/hey-iris_en_windows_v4_0_0.ppn

# ── Port overrides (optional) ───────────────────────────────────────────
# These default to sensible values that avoid conflicts with other services.
# IRIS owned ports use the 18xxx range (18000 + IRIS).
# Provider endpoints default to their conventional ports.
#
# IRIS_BACKEND_PORT=8090
# IRIS_BRAIN_PORT=18182
# IRIS_VISION_PORT=18181
# IRIS_LMSTUDIO_URL=http://localhost:1234
# IRIS_OLLAMA_URL=http://localhost:11434
# IRIS_SWARM_DIRECTOR_PORT=8081
# IRIS_SWARM_WORKERS_PORT=8082
# IRIS_LOCAL_MODEL_PORT=8082

# ── WebSocket URL (optional) ────────────────────────────────────────────
# Frontend reads this at build/runtime to connect to the backend.
# NEXT_PUBLIC_WS_URL=ws://localhost:8090/ws/iris

# ── Caducean phase scheduler (quota pacing) ─────────────────────────────
# Paces LLM calls against each provider's rate limit instead of firing into an
# exhausted quota and eating 429 backoff. Unset = DISABLED, which is how it
# shipped: every gate logged "GATE_DECISION ... reason=flag_off" and no pacing
# happened at all. The gate is fail-open — any internal error admits the call.
# Ceilings are per provider and learned from that provider: from its published
# per-minute limit header when it sends one, else from observed 429s. No rpm
# value is hardcoded for any vendor.
IRIS_PHASE_SCHEDULER=1

# Extra per-minute request-limit header spellings, comma-separated, for a
# provider whose header is not already recognised. ONLY per-minute headers —
# an hour/day figure read as rpm sets a ceiling far too high and silently
# disables the gate.
# IRIS_RPM_LIMIT_HEADERS=x-my-provider-rpm-limit

# ── Websearch run ceiling ───────────────────────────────────────────────
# One deadline for a whole dispatch, enforced (not merely checked). The number
# of sources does not change how long a search takes; the run gathers what it
# can inside the ceiling and reports what it could not read.
# IRIS_WEBSEARCH_MAX_WALL_MS=90000
